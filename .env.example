OPENAI_API_KEY=your_openai_compatible_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
PRIMARY_MODEL=your_primary_chat_model
# Stable identity used for usage/cost lookup; never derive it from a secret base URL.
MODEL_PROVIDER_ID=openai_compatible
# Optional versioned JSON price table. Empty means estimated cost stays unknown.
MODEL_PRICE_TABLE_PATH=

EMBEDDING_API_KEY=your_embedding_api_key
EMBEDDING_API_BASE=https://api.openai.com/v1
EMBEDDING_MODEL=your_embedding_model

BACKUP_API_BASE=
BACKUP_API_KEY=
BACKUP_MODEL=

TAVILY_API_KEY=
TAVILY_DAILY_LIMIT=10
PROXY_URL=

REDIS_URL=redis://localhost:6379
REDIS_SETUP_MAX_ATTEMPTS=60
REDIS_SETUP_RETRY_SECONDS=1.0
# Total attempts for idempotent LLM, embedding, and web transport calls.
TRANSPORT_RETRY_MAX_ATTEMPTS=3
TRANSPORT_RETRY_INITIAL_DELAY_SECONDS=0.25
TRANSPORT_RETRY_MAX_DELAY_SECONDS=2.0
TRANSPORT_RETRY_BACKOFF_MULTIPLIER=2.0
TRANSPORT_RETRY_JITTER_RATIO=0.2
# Do not wait indefinitely when a provider asks for a long Retry-After delay.
TRANSPORT_RETRY_MAX_RETRY_AFTER_SECONDS=30.0
GUARDRAIL_APPROVAL_TTL_SECONDS=900
LANGGRAPH_RECURSION_LIMIT=80
# Request-local monotonic deadline; 0 disables it.
REQUEST_MAX_SECONDS=300
# Durable workflow call caps; 0 disables the corresponding cap.
WORKFLOW_MAX_LLM_CALLS=32
WORKFLOW_MAX_TOOL_CALLS=48
# Usage is still recorded when token/cost enforcement is disabled.
WORKFLOW_MAX_TOTAL_TOKENS=0
WORKFLOW_MAX_ESTIMATED_COST_USD=0
# Block the next identical tool call after this many consecutive allowed calls.
MAX_IDENTICAL_TOOL_REPEATS=2
# Shared budget for read_docs and web_search within one parser step.
PARSER_MAX_RETRIEVAL_CALLS=6
# Maximum argument-repair reflection rounds across one graph request/resume chain.
MAX_REFLECTION_ROUNDS=1
HYBRID_RAG_TOP_K=5
HYBRID_RAG_BM25_TOP_K=8
HYBRID_RAG_VECTOR_TOP_K=8
HYBRID_RAG_RRF_K=60
SEED_DOC_STORE_ON_EMPTY=false
DATA_PATH=./tech_doc_agent/data
LOG_LEVEL=INFO
# Optional HMAC key for stable user_id pseudonyms; use at least 16 random bytes and keep it secret.
TELEMETRY_PSEUDONYM_KEY=
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_FLUSH_ON_REQUEST=false
LANGFUSE_ENVIRONMENT=local
LANGFUSE_RELEASE=
